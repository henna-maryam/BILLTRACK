{
  "name": "billtrack",
  "private": true,
  "version": "0.1.0",
  "description": "BillTrack multi-tenant shop management platform.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @billtrack/db generate",
    "db:migrate": "pnpm --filter @billtrack/db migrate",
    "db:seed": "pnpm --filter @billtrack/db seed",
    "studio": "pnpm --filter @billtrack/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
